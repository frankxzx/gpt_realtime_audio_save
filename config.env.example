# Configuration for GPT Realtime Audio Handler
# Copy this file to .env and fill in your values

# OpenAI API Key for Realtime API access
OPENAI_API_KEY=your_openai_api_key_here

# Azure Blob Storage Configuration
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string_here
AZURE_STORAGE_CONTAINER=audio-recordings

# Audio Settings
# Sample rate for GPT Realtime API (default: 24000)
AUDIO_SAMPLE_RATE=24000

# Number of audio channels (default: 1 for mono)
AUDIO_CHANNELS=1

# MP3 Export Settings
MP3_BITRATE=128k

# Silence gap between input and output audio (in milliseconds)
SILENCE_GAP_MS=500
